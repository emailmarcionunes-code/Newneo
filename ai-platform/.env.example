# Use distinct migration-owner and restricted runtime credentials.
MIGRATION_DATABASE_URL=postgresql://newneo_owner:replace_me@127.0.0.1:5434/newneo
DATABASE_URL=postgresql://newneo_app:replace_me@127.0.0.1:5434/newneo
POSTGRES_PASSWORD=replace_me
# Configure the OIDC authorization-code client and its exact issuer.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Match the exact browser origin; HTTPS is required outside localhost.
APP_ORIGIN=http://localhost:3100
# Generate with: openssl rand -hex 32
SESSION_SECRET=
APP_DATABASE_PASSWORD=
PUBLIC_HOST=
# Trusted administrator bootstrap only. Subject is the stable OIDC sub, not email.
BOOTSTRAP_SUBJECT=
BOOTSTRAP_ORGANIZATION=
BOOTSTRAP_WORKSPACE=
BOOTSTRAP_CAN_EDIT=false
